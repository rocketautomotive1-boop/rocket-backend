# Template do .env de produção — copiar para `.env` na VM e preencher com valores reais.
# NUNCA commitar o .env real.

API_BASE_URL=
PUBLIC_BACKEND_URL=
INTERNAL_API_KEY=
MP_CRYPTO_KEY=

# Assinatura de tokens JWT (login de usuário/cliente). NUNCA deixar vazio —
# sem isso o código cai no fallback hardcoded 'marketplace_integration_secret'
# (visível no próprio repositório), permitindo forjar tokens válidos.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Origens permitidas para CORS com cookies (refresh token do admin é
# HttpOnly cookie — exige origin explícito, não aceita '*'). Adicionar a URL
# de produção do admin aqui quando o domínio existir.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# --- MongoDB ---
# Replica set com auth (mongod + mongot para $search) — ver infra/mongo-prod/README.md
# para gerar credenciais e subir o setup inicial. Aponta para o serviço "mongodb"
# da rede interna do docker-compose.prod.yml, não para localhost.
MONGO_URI=mongodb://rocket_app:<SENHA_APP>@mongodb:27017/rocket_db?authSource=admin&replicaSet=rs0

# --- DB relacional (TypeORM/MySQL) ---
# DESATIVADO no código (comentado em src/app.module.ts). Pode deixar vazio/omitir.
# DB_HOST=
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=

# --- RabbitMQ ---
# Aponta para o serviço "rabbitmq" da rede interna do docker-compose.prod.yml.
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_MARKETPLACE_QUEUE=marketplace_queue
RABBITMQ_PRODUCT_QUEUE=product_queue

